Vagrant.configure("2") do |config|
  
  # Base OS (Ubuntu 22.04 LTS)
  config.vm.box = "ubuntu/jammy64"
  
  # -------------------------------------------------------------
  # Master Node (k8s-master)
  # -------------------------------------------------------------
  config.vm.define "k8s-master" do |master|
    master.vm.hostname = "k8s-master"
    master.vm.network "private_network", ip: "192.168.56.10"
    
    master.vm.provider "virtualbox" do |vb|
      vb.name = "k8s-master"
      vb.memory = 2048  # Minimum required for kubeadm
      vb.cpus = 2       # Minimum required for kubeadm
    end
  end

  # -------------------------------------------------------------
  # Worker Nodes (k8s-worker-1 && k8s-worker-2)
  # -------------------------------------------------------------
  (1..2).each do |i|
    config.vm.define "k8s-worker-#{i}" do |worker|
      worker.vm.hostname = "k8s-worker-#{i}"
      worker.vm.network "private_network", ip: "192.168.56.#{10 + i}"
      
      worker.vm.provider "virtualbox" do |vb|
        vb.name = "k8s-worker-#{i}"
        vb.memory = 1536 # FineTune as desired
        worker.vm.provider "virtualbox" do |vb|
          vb.cpus = 1
        end
      end
    end
  end

end
